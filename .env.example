# ── LLM 大模型（必填）──
# 支持 OpenAI 兼容接口（DeepSeek / 通义千问 / Kimi / GPT 等）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Obsidian 集成（可选）──
# 装 Local REST API 插件后填入 Vault 路径
# OBSIDIAN_VAULT=/Users/xxx/你的知识库
# OBSIDIAN_API_URL=http://127.0.0.1:27124

# ── 小红书集成（可选）──
# 浏览器登录后从 F12 → Application → Cookies 复制
# XHS_COOKIE=your_cookie_here
